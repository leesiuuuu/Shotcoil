  <PropertyGroup>
    <!-- 산출물 이름. 프로젝트/폴더 이름(Project1)은 그대로 두고 배포되는 파일만
         Shotcoil.exe로 낸다 - 공모전 제출물이 Project1.exe면 곤란하다. -->
    <TargetName>Shotcoil</TargetName>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <PreBuildEvent>
      <!-- galmuri.h에는 main.c에 실제로 쓰인 글자만 들어간다. 새 한글을 넣고
           이걸 다시 안 돌리면 그 글자는 raylib이 인덱스 0(공백)으로 대체해서
           화면에서 통째로 사라진다 - 물음표조차 안 뜨므로 눈치채기 어렵다.
           내용이 같으면 make-font.py가 파일을 건드리지 않으므로 재컴파일은
           실제로 글자가 바뀐 빌드에서만 발생한다. -->
      <Message>galmuri.h 재생성</Message>
      <Command>where python &gt;nul 2&gt;&amp;1 &amp;&amp; python "$(ProjectDir)..\..\third_party\make-font.py" || echo [WARNING] galmuri.h not regenerated - newly added Korean text will draw as blank</Command>
    </PreBuildEvent>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Debug|Win32'">
    <ClCompile>
      <WarningLevel>Level3</WarningLevel>
